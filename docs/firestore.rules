rules_version = '2';
// ============================================================
// FitCore GMS — Firestore Security Rules (v2.1)
// Paste into: Firebase console → Firestore → Rules → Publish
//
// NOTE: The app uses custom document IDs (u1, MEM-0001, etc.)
// for users/members — NOT Firebase Auth UIDs.  This means we
// cannot use get() to look up roles by request.auth.uid.
//
// Security is therefore enforced in two layers:
//   1. Firestore Rules: auth gate + collection-level protection
//   2. App Logic: role checks, activation gate, panel access
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Meta (bootstrap flag) ──────────────────────────────
    match /meta/{doc} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/meta/config);
      allow update, delete: if false;
    }

    // ─── Public catalogue ───────────────────────────────────
    // Guests (landing page / member signup) can read plans
    // and settings without signing in.  Writes require auth.
    match /plans/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /exerciseLibrary/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Members collection: allow unauthenticated reads for cross-device login
    // lookup (username → authEmail resolution).  This exposes member profile
    // data but NOT passwords (stored in Firebase Auth, not Firestore).
    match /members/{doc} {
      allow read: if true;
    }

    // ─── App collections (auth required) ───────────────────
    // All personal/app collections require authentication.
    // Role-based access control is enforced in app logic
    // (sidebar rendering, navigate(), panel guards).
    match /{collection}/{doc} {
      allow read: if request.auth != null
        && collection in ['users','members','payments','sessions',
                          'attendance','walkins','notifications','messages',
                          'announcements','activitylog','workouts',
                          'workoutPlans','measurements','goals',
                          'exerciseLibrary'];
      allow create: if request.auth != null
        && collection in ['users','members','payments','sessions',
                          'attendance','walkins','notifications','messages',
                          'announcements','activitylog','workouts',
                          'workoutPlans','measurements','goals',
                          'exerciseLibrary'];
      allow update: if request.auth != null
        && collection in ['users','members','payments','sessions',
                          'attendance','walkins','notifications','messages',
                          'announcements','activitylog','workouts',
                          'workoutPlans','measurements','goals',
                          'exerciseLibrary'];
      allow delete: if request.auth != null
        && collection in ['users','members','payments','sessions',
                          'attendance','walkins','notifications','messages',
                          'announcements','activitylog','workouts',
                          'workoutPlans','measurements','goals',
                          'exerciseLibrary'];
    }

    // ─── Catch-all: deny everything else ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
