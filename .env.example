# Local-only WorkoutX key for scripts/sync-workoutx.cjs.
# On Vercel, set WX_API_KEY in Project Settings -> Environment Variables instead.
WX_API_KEY=wx_your_key_here

# --- Forgot Password (set these in Vercel -> Settings -> Environment Variables) ---
# Gmail that SENDS the code (needs 2-Step Verification ON, then create an App Password)
GMAIL_USER=yourgym@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Firebase Console -> Project settings -> Service accounts -> Generate new private key (paste whole JSON, one line)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Any long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
RESET_SECRET=change-me-to-a-long-random-string
# Extra site origins allowed to call the API (comma-separated), optional
ALLOWED_ORIGINS=
